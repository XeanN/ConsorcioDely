{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consorciodely-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Nota: el Hyperdrive "consorciodely-db" (id 70862d1ccfa04d4e99c0d4431fe7a828)
  // se creó pensando en el driver `pg`, pero `pg` requiere `pg-cloudflare`
  // para hablar TCP en Workers y eso rompe el bundle de OpenNext (ver
  // historial de commits). Se cambió a @neondatabase/serverless (HTTP/WS,
  // sin necesidad de Hyperdrive) — el recurso queda creado en Cloudflare
  // pero sin usarse; no cuesta nada dejarlo así.
  // Bucket de R2 para las imágenes del catálogo.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "consorciodely-media"
    }
  ]
}
