{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consorciodely-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Reemplazar "id" con el ID real una vez creado el Hyperdrive en el dashboard
  // de Cloudflare (Workers & Pages -> Hyperdrive), apuntando a la connection
  // string directa de Neon. Ver README para el paso a paso.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REEMPLAZAR_CON_ID_DE_HYPERDRIVE"
    }
  ],
  // Bucket de R2 para las imágenes del catálogo.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "consorciodely-media"
    }
  ]
}
