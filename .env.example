# Conexión a Neon Postgres. DATABASE_URL (pooled) la usa la app tanto en
# local como en producción (vía @neondatabase/serverless, ver src/lib/db.ts
# — sin Prisma de por medio en el runtime de Workers). DIRECT_URL solo la
# usa el CLI de Prisma (migrate) y los scripts.

DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/consorciodely?sslmode=require"

# Directa (sin -pooler) — la usa `prisma migrate` (los advisory locks no
# sobreviven bien al pooling de PgBouncer).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/consorciodely?sslmode=require"

# Firma las cookies de sesión del admin (HMAC-SHA256). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# En producción se setea como secret del Worker: `wrangler secret put AUTH_SECRET`.
AUTH_SECRET=""

# Solo para `pnpm run seed:admin` — crea/actualiza el primer usuario admin.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# URL pública del bucket R2 (R2 -> bucket -> Settings -> Public Access).
# En producción también está declarada en wrangler.jsonc ("vars").
MEDIA_PUBLIC_BASE_URL=""

# URL pública del sitio (sitemap, JSON-LD, canonical). En producción
# también está en wrangler.jsonc ("vars") — cambiar ahí al conectar el
# dominio propio.
SITE_URL="http://localhost:3000"
